# Hermes Agent - Multi-Provider Configuration
# Fallback chain: OpenCode Zen (minimax) -> Gemini -> Ollama (local)

# === OpenCode Zen (Primary - MiniMax M2.5 Free) ===
OPENCODE_ZEN_ENABLED=true
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1/chat/completions
OPENCODE_ZEN_MODEL=minimax-m2.5-free
OPENCODE_API_KEY=sk-YOUR_ROTATED_KEY_HERE
OPENCODE_ZEN_API_KEY=sk-YOUR_ROTATED_KEY_HERE
OPENCODE_KEY_LIMIT=1000

# === Gemini (Fallback) ===
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=AIzaSy-YOUR_ROTATED_KEY_HERE
GEMINI_KEY_LIMIT=1500

# === Ollama Local (Final Fallback) ===
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# === General Settings ===
HERMES_AGENT_ENABLED=true
HERMES_AGENT_AUTO_ROTATE=true

# === Rate Limiting ===
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# === Key Rotation ===
HERMES_KEY_ROTATION_STRATEGY=priority-based
HERMES_KEY_MAX_RETRIES=3
HERMES_KEY_RETRY_DELAY_MS=1000
HERMES_KEY_CHECK_INTERVAL_MS=300000

# === Logging ===
LOG_LEVEL=info
LOG_FORMAT=json
LOG_INCLUDE_KEY_HASH=true

# === Cache ===
CACHE_ENABLED=true
CACHE_TTL_MS=300000
CACHE_MAX_SIZE=1000

# === Environment ===
NODE_ENV=development
