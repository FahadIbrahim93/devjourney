# ═══════════════════════════════════════════════════════════════════
# Hope Theory Shadow Clone Jutsu — Webhook Subscriptions
# Push clone outputs to Telegram / Discord / Webhook.site
# ═══════════════════════════════════════════════════════════════════

# ─── TELEGRAM (recommended) ─────────────────────────────────────
# Get bot token: https://t.me/BotFather → /newbot
# Get chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=***  # Replacemnt for real token
TELEGRAM_CHAT_ID=*** actual chat id from getUpdates
# Example webhook URL (built dynamically from bot + chat id):
# https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>&text=<MESSAGE>

# ─── DISCORD (alternative) ──────────────────────────────────────
# Get webhook URL: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/abc_replace_with_real

# ─── SLACK (alternative) ───────────────────────────────────────
# Get webhook URL: api.slack.com/messaging/webhooks → Create
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/0000/0000/abc_replace

# ─── NTFY (simplest — no signup needed) ─────────────────────────
# Pick a unique topic, then anyone can subscribe at ntfy.sh/<topic>
NTFY_TOPIC=hope-theory-clones-fahad_replace_with_unique

# ─── WEBHOOK.SITE (testing) ─────────────────────────────────────
# Get a free URL: https://webhook.site
# Useful for debugging clone outputs before wiring to real services
WEBHOOK_SITE_URL=https://webhook.site/00000000-0000-0000-0000-000000000000

# ═══════════════════════════════════════════════════════════════════
# DELIVERY CONFIG
# ═══════════════════════════════════════════════════════════════════

# Which channels to use (comma-separated: telegram,discord,slack,ntfy,webhook)
DELIVERY_CHANNELS=telegram,ntfy

# Quiet hours (24h format) — no notifications between these
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# Max message length (chars) before truncating
MAX_MESSAGE_LENGTH=3500

# Always deliver, even if delivery channel is down (fallback to log file)
ALWAYS_LOG_TO_FILE=true
LOG_FILE=~/.hermes/profiles/naruto_main/delivery.log
