# 🌍 .env.example — Hope Theory Shadow Clone Jutsu
# Copy to ~/.hermes/.env (or wherever your Hermes config reads env from)

# ═══════════════════════════════════════════════════════════════════
# REQUIRED (minimum to run any free model)
# ═══════════════════════════════════════════════════════════════════

# OpenRouter — your existing key, used for all `:free` models
# Get one free at: https://openrouter.ai/keys
OPENAI_API_KEY=<your-...key>

# Google Gemini API — direct access, 1500 req/day free
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=***

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL (more free models + fallbacks)
# ═══════════════════════════════════════════════════════════════════

# Groq — fast inference, 30 RPM free
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=***

# DeepSeek — direct API, $5 free credit
# Get one free at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=<your-...key>

# Cerebras — very fast, 30 RPM free
# Get one free at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=***

# Hugging Face — free inference for some models
# Get one free at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_***

# ═══════════════════════════════════════════════════════════════════
# LOCAL (no key needed — Ollama runs on your machine)
# ═══════════════════════════════════════════════════════════════════
# OLLAMA_HOST=http://localhost:11434

# ═══════════════════════════════════════════════════════════════════
# VENTURE-SPECIFIC (only if you wire them up)
# ═══════════════════════════════════════════════════════════════════

# Klaviyo (Marjahans email)
# KLAVIYO_API_KEY=***

# GitHub (Code Ninja)
# GITHUB_TOKEN=ghp_***

# Telegram (clone notifications — for future use)
# TELEGRAM_BOT_TOKEN=***

# ═══════════════════════════════════════════════════════════════════
# NEVER commit this file with real keys!
# Add .env to .gitignore
# ═══════════════════════════════════════════════════════════════════
